    </screenshot>
    <screenshot>
      <caption>Mod installation</caption>
      <image type="source" width="848" height="558">https://prismlauncher.org/img/screenshots/ModInstallDark.png</image> <!-- MTODO;TODO : Change to Majnruj Launcher screenshot -->
    </screenshot>
    <screenshot>
      <caption>Mod updating</caption>
      <image type="source" width="860" height="748">https://prismlauncher.org/img/screenshots/ModUpdateDark.png</image> <!-- MTODO;TODO : Change to Majnruj Launcher screenshot -->
    </screenshot>
    <screenshot>
      <caption>Instance management</caption>
      <image type="source" width="960" height="659">https://prismlauncher.org/img/screenshots/PropertiesDark.png</image> <!-- MTODO;TODO : Change to Majnruj Launcher screenshot -->
